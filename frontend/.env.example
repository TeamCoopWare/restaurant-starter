# ============================================================
#  Frontend configuration (copy to .env.local and fill in)
#  NEXT_PUBLIC_* values are inlined into the static bundle — put NO secrets here.
# ============================================================

# Stripe publishable (TEST) key — safe to expose
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Base URL of the ordering backend.
# Local dev: http://localhost:4000
# Production: the order subdomain — https://order.sedapeatery.com.au
NEXT_PUBLIC_API_URL=http://localhost:4000

# Restaurant timezone — used for the weekend-only (Banana Leaf) check.
NEXT_PUBLIC_TIMEZONE=Australia/Adelaide
