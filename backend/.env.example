# ============================================================
#  Backend configuration (copy to .env and fill in)
#  Example values are for LOCAL/STAGING only — never the live host.
# ============================================================

# --- Odoo (staging) ---
ODOO_URL=http://localhost:8069
ODOO_DB=sedap_staging
ODOO_USERNAME=
ODOO_PASSWORD=
# Bearer token for the custom Odoo /api/menu + image endpoints
ODOO_API_KEY=

# --- Stripe (use TEST keys in staging) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional: force the POS "Stripe Online" payment method id.
# Leave blank to resolve it by name at startup.
STRIPE_ONLINE_PM_ID=

# --- App ---
# Where the website is served (used for Stripe success/cancel redirects)
FRONTEND_URL=http://localhost:3000
PORT=4000

# Shared secret for POS-only endpoints (/api/holiday/toggle). Keep PRIVATE —
# never expose in any NEXT_PUBLIC_ var or the frontend bundle. Use a long random value.
API_KEY=

# Password for the website's /admin page (show/hide menu items).
# MUST be different from API_KEY: this one gets typed into a browser and
# kept in localStorage, API_KEY is the POS bridge secret and must not be.
ADMIN_KEY=change-me-to-a-long-random-string

# Comma-separated browser origins allowed by CORS (falls back to FRONTEND_URL)
ALLOWED_ORIGINS=http://localhost:3000

# IANA timezone for pickup-slot generation
TIMEZONE=Australia/Adelaide

# How many near-term pickup slots to offer on the website (kept small so the
# kitchen only ever gets orders due soon). 4 = next ~80 min at 20-min intervals.
SLOTS_AHEAD=4

# --- Odoo instance ids (verify per instance) ---
# POS "Takeout" preset id
PRESET_ID=2
# Sale tax id for the 10% public-holiday surcharge
HOLIDAY_TAX_ID=39
